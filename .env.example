# Copy to .env for running the app outside Docker (npm run dev).
# These are local development values only: never put real credentials here.

# Used by the app and by Prisma. Matches the Postgres service in docker-compose.yml.
DATABASE_URL="postgresql://learning_goals:change_me_locally@localhost:5432/learning_goals"

# Optional overrides read by docker-compose.yml.
POSTGRES_USER=learning_goals
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=learning_goals
POSTGRES_PORT=5432
APP_PORT=3000
