generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Goal {
  id          String   @id @default(cuid())
  title       String
  targetSkill String
  done        Boolean  @default(false)
  targetDate  DateTime?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
